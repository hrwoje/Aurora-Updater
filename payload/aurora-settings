            else:
                run_cmd("pkill", "wlsunset")

        sw_night.connect("state-set", toggle_night)
        def night_temperature_changed(adjustment):
            temp = int(adjustment.get_value())
            set_setting("display.nightlight-temperature", temp)
            if sw_night.get_active():
                run_cmd("pkill", "wlsunset")
