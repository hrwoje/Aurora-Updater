        # Zoekactie logica
        def do_search():
            q = search_entry.get_text().strip()
            if not q:
                return
            search_spinner.start()
            while child := results_list.get_first_child():
                results_list.remove(child)

            def worker():
                res = run_cmd("xbps-query", "-Rs", q, timeout=20)
                items = []
                if res and res.stdout:
                    for line in res.stdout.splitlines()[:60]:
                        parts = line.split(None, 2)
                        if len(parts) >= 2:
                            is_inst = parts[0].startswith("[*]")
                            pkg_ver = parts[1]
                            pkg_name = re.sub(r"-[^-]+$", "", pkg_ver)
                            desc = parts[2] if len(parts) > 2 else ""
                            items.append((pkg_name, pkg_ver, desc, is_inst))

                def update_ui():
                    search_spinner.stop()
                    if not items:
                        results_list.append(Gtk.Label(label=f"Geen software gevonden voor '{q}'.", xalign=0.0))
                        return
                    for pname, pver, pdesc, is_inst in items:
                        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                        lbl = Gtk.Label(label=f"<b>{esc(pname)}</b> ({esc(pver)})\n<span size='small'>{esc(pdesc)}</span>", use_markup=True, xalign=0.0)
