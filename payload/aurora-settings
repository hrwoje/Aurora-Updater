        def refresh_connections():
            while child := conn_rows.get_first_child(): conn_rows.remove(child)
            rows = active_network_connections()
            if not rows:
                conn_rows.append(Gtk.Label(label="Geen actieve externe verbindingen gemeld door ss.", xalign=0.0))
                return
            for item in rows:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                text = f"{item['direction']} · {item['proto']} · {item['local']} → {item['peer']}"
                lbl = Gtk.Label(label=esc(text), xalign=0.0); lbl.set_hexpand(True); lbl.add_css_class("monospace")
                row.append(lbl)
                ip = item["ip"]
                block = Gtk.Button(label="Blokkeren")
                unblock = Gtk.Button(label="Deblokkeren")
                def apply_ip(button, action, address=ip):
                    try:
                        parsed = ipaddress.ip_address(address)
                        cidr = f"{parsed}/128" if parsed.version == 6 else f"{parsed}/32"
                    except ValueError:
                        return
                    ufw_args = ("delete", "deny", "from", cidr) if action == "delete" else ("deny", "from", cidr)
                    result = run_ufw(*ufw_args)
                    button.set_label("Klaar" if result and result.returncode == 0 else "Mislukt")
                    refresh_fw_rules()
                block.connect("clicked", apply_ip, "deny")
                unblock.connect("clicked", apply_ip, "delete")
                row.append(block); row.append(unblock)
                conn_rows.append(row)

        def update_traffic():
            nonlocal last_bytes
            rx, tx = network_traffic_bytes(); now = time.monotonic()
            elapsed = max(now - last_bytes[2], 0.1)
            rx_rate, tx_rate = max(0, rx - last_bytes[0]) / elapsed, max(0, tx - last_bytes[1]) / elapsed
            last_bytes = [rx, tx, now]
            samples_rx.append(rx_rate); samples_tx.append(tx_rate)
            del samples_rx[:-60]; del samples_tx[:-60]
            traffic_label.set_text(f"RX inkomend: {rx_rate / 1024:.1f} KiB/s   |   TX uitgaand: {tx_rate / 1024:.1f} KiB/s")
            graph.queue_draw()
            refresh_connections()
            return True

        refresh_connections()
        GLib.timeout_add(1000, update_traffic)
        net_card.get_last_child().append(net_box)
        box.append(net_card)

        # AppArmor
        aa_card = self.create_card_group("AppArmor Beveiligingsprofielen", "Mandatory Access Control profielen voor systeembescherming")
