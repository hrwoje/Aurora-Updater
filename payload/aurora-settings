    def build_printers_page(self):
        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(20); box.set_margin_bottom(20); box.set_margin_start(24); box.set_margin_end(24)
        box.append(self.create_page_header("Printers & Afdrukbeheer", "Beheer aangesloten en netwerkprinters via CUPS", "printer-symbolic"))

        print_card = self.create_card_group("Geïnstalleerde Printers", "Printers die momenteel zijn geconfigureerd in CUPS")
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_find_printers = Gtk.Button(label="🔍 Zoeken naar nieuwe printers...")
        btn_find_printers.add_css_class("suggested-action")
        btn_cups_web = Gtk.Button(label="🌐 CUPS Webbeheer (localhost:631)")
        btn_refresh = Gtk.Button(label="Vernieuwen")
        top_bar.append(btn_find_printers)
        top_bar.append(btn_cups_web)
        top_bar.append(btn_refresh)
        print_card.get_last_child().append(top_bar)

        p_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        p_list.set_margin_top(12)
        print_card.get_last_child().append(p_list)
        box.append(print_card)

        def refresh_printers():
            while child := p_list.get_first_child():
                p_list.remove(child)

            res = run_cmd("lpstat", "-p", "-d")
            printers_found = []
            default_p = None
            if res and res.stdout:
                for line in res.stdout.splitlines():
                    if line.startswith("printer "):
                        pname = line.split()[1]
                        desc = line.split("is", 1)[1].strip() if "is" in line else "Gereed"
                        printers_found.append((pname, desc))
                    elif "system default destination:" in line:
                        default_p = line.split(":", 1)[1].strip()

            if not printers_found:
                p_list.append(Gtk.Label(label="Geen printers geïnstalleerd. Klik op 'Zoeken naar nieuwe printers' om printers toe te voegen.", xalign=0.0))
                return

            for pname, desc in printers_found:
                prow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                is_def = pname == default_p
                lbl = Gtk.Label(label=f"<b>{esc(pname)}</b> {'(Standaard)' if is_def else ''}\n<span size='small'>{esc(desc)}</span>", use_markup=True, xalign=0.0)
                lbl.set_hexpand(True)
                prow.append(lbl)

                btn_test = Gtk.Button(label="Testpagina")
                btn_test.connect("clicked", lambda b, p=pname: run_cmd("lp", "-d", p, "/usr/share/cups/data/testprint"))
                prow.append(btn_test)

                if not is_def:
                    btn_def = Gtk.Button(label="Als standaard")
                    btn_def.connect("clicked", lambda b, p=pname: (run_admin_cmd("printer-default", p), refresh_printers()))
                    prow.append(btn_def)

                btn_del = Gtk.Button(label="Verwijderen")
                btn_del.add_css_class("destructive-action")
                btn_del.connect("clicked", lambda b, p=pname: (run_admin_cmd("printer-remove", p), refresh_printers()))
                prow.append(btn_del)

                p_list.append(prow)
                p_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        # Dialoog voor nieuwe printers zoeken
        def open_find_printers_dialog(b):
            dlg = Gtk.Window(transient_for=self.win, modal=True, title="Zoeken naar printers")
            dlg.set_default_size(500, 360)
            d_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            d_box.set_margin_top(16); d_box.set_margin_bottom(16); d_box.set_margin_start(16); d_box.set_margin_end(16)

            d_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            spinner = Gtk.Spinner()
            spinner.start()
            status_lbl = Gtk.Label(label="Scannen naar USB- en netwerkprinters op het lokale netwerk...", xalign=0.0)
            status_lbl.set_hexpand(True)
            d_top.append(spinner)
            d_top.append(status_lbl)
            d_box.append(d_top)

            found_scroll = Gtk.ScrolledWindow()
            found_scroll.set_size_request(-1, 240)
            found_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            found_scroll.set_child(found_list)
            d_box.append(found_scroll)

            btn_close = Gtk.Button(label="Sluiten")
            btn_close.connect("clicked", lambda b: dlg.destroy())
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            btn_box.set_halign(Gtk.Align.END)
            btn_box.append(btn_close)
            d_box.append(btn_box)

            def worker():
                res = run_admin_cmd("printer-scan", timeout=20)
                devices = []
                if res and res.stdout:
                    for line in res.stdout.splitlines():
                        line = line.strip()
                        if line.startswith("network dnssd://") or line.startswith("network socket://") or line.startswith("network ipps://") or line.startswith("direct usb://"):
                            uri = line.split(None, 1)[1] if len(line.split(None, 1)) > 1 else line
                            # Clean name
                            p_name = "Netwerkprinter"
                            if "dnssd://" in uri:
                                match = re.search(r"dnssd://([^/?]+)", uri)
                                if match:
                                    import urllib.parse
                                    p_name = urllib.parse.unquote(match.group(1)).replace("._ipp._tcp.local", "").replace("._ipps._tcp.local", "")
                            elif "socket://" in uri:
                                p_name = f"Printer ({uri.split('socket://')[1].split('/')[0]})"
                            elif "usb://" in uri:
                                p_name = f"USB Printer ({uri.split('usb://')[1].split('?')[0]})"
                            devices.append((p_name, uri))

                def ui_done():
                    spinner.stop()
                    if not devices:
                        status_lbl.set_text("Geen nieuwe printers gevonden.")
                        found_list.append(Gtk.Label(label="Zorg dat de printer aan staat en verbonden is met hetzelfde netwerk.", xalign=0.0))
                        return
                    status_lbl.set_text(f"{len(devices)} printer(s) gevonden op het netwerk:")
                    for pname, puri in devices:
                        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                        lbl = Gtk.Label(label=f"<b>{esc(pname)}</b>\n<span size='small'>{esc(puri)}</span>", use_markup=True, xalign=0.0)
                        lbl.set_hexpand(True)
                        row.append(lbl)

                        btn_add = Gtk.Button(label="Toevoegen")
                        btn_add.add_css_class("suggested-action")
                        clean_sys_name = re.sub(r"[^a-zA-Z0-9_-]", "_", pname)[:30]
                        btn_add.connect("clicked", lambda b, n=clean_sys_name, u=puri: (
                            run_admin_cmd("printer-add", n, u),
                            dlg.destroy(),
                            refresh_printers()
                        ))
                        row.append(btn_add)
                        found_list.append(row)
                        found_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

                GLib.idle_add(ui_done)

            threading.Thread(target=worker, daemon=True).start()
            dlg.set_child(d_box)
            dlg.present()

        btn_find_printers.connect("clicked", open_find_printers_dialog)
        btn_cups_web.connect("clicked", lambda b: subprocess.Popen(["xdg-open", "http://localhost:631"]))
        btn_refresh.connect("clicked", lambda b: refresh_printers())
        refresh_printers()

        scrolled.set_child(box)
        return scrolled

