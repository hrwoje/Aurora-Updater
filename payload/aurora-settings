        disk_label = Gtk.Label(label="Meten…", xalign=0.0); disk_label.add_css_class("monospace")
        live_box.append(disk_title); live_box.append(disk_area); live_box.append(disk_label)
        devices_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        live_box.append(devices_box)

        previous_cpu = [None]
        previous_disk = [None]
        previous_time = [time.monotonic()]

        def read_cpu():
            values = {}
            try:
                for line in open("/proc/stat", encoding="ascii"):
                    parts = line.split()
                    if parts and (parts[0] == "cpu" or re.fullmatch(r"cpu[0-9]+", parts[0])):
                        nums = [int(x) for x in parts[1:8]]
                        values[parts[0]] = (sum(nums), nums[3] + nums[4])
            except (OSError, ValueError):
                pass
            return values

        def read_mem():
            vals = {}
            try:
                for line in open("/proc/meminfo", encoding="ascii"):
                    key, value = line.split(":", 1); vals[key] = int(value.split()[0]) * 1024
            except (OSError, ValueError):
                return 0.0
            total = vals.get("MemTotal", 0); available = vals.get("MemAvailable", vals.get("MemFree", 0))
            return (100.0 * (total - available) / total) if total else 0.0

        def read_disk_io():
            total_read = total_write = 0
            for path in glob.glob("/sys/block/*/stat"):
                name = path.split("/")[-2]
                if name.startswith(("loop", "ram", "zram")): continue
                try:
                    parts = open(path, encoding="ascii").read().split()
                    total_read += int(parts[2]) * 512; total_write += int(parts[6]) * 512
                except (OSError, ValueError, IndexError):
                    pass
            return total_read, total_write

        def refresh_devices():
            while child := devices_box.get_first_child(): devices_box.remove(child)
            res = run_cmd("lsblk", "-dnbo", "NAME,SIZE,TYPE,MODEL", timeout=5)
            lines = res.stdout.splitlines() if res and res.returncode == 0 else []
            if not lines:
                devices_box.append(Gtk.Label(label="Geen schijven gemeld door lsblk.", xalign=0.0)); return
            for line in lines:
                parts = line.split(None, 3)
                if len(parts) >= 3 and parts[2] == "disk":
                    name, size = parts[0], parts[1]
                    model = parts[3] if len(parts) >= 4 else ""
                    if name.startswith("zram"):
                        model = (model + " · virtueel zram-apparaat").strip(" ·")
                    devices_box.append(Gtk.Label(label=esc(f"/dev/{name} · {size} bytes · {model}"), xalign=0.0))
            mounts = run_cmd("findmnt", "-rn", "-o", "TARGET,SOURCE,FSTYPE", timeout=5)
            if mounts and mounts.returncode == 0:
                devices_box.append(Gtk.Label(label="<b>Gekoppelde bestandenystemen en gebruik:</b>", use_markup=True, xalign=0.0))
                for mount_line in mounts.stdout.splitlines():
                    mount_parts = mount_line.split(None, 2)
                    if len(mount_parts) < 2 or not mount_parts[0].startswith("/"): continue
                    target, source = mount_parts[0], mount_parts[1]
                    try:
                        usage = shutil.disk_usage(target); used = 100.0 * usage.used / usage.total if usage.total else 0.0
                        devices_box.append(Gtk.Label(label=esc(f"{source} → {target} · {used:.1f}% gebruikt ({usage.used / 1e9:.1f}/{usage.total / 1e9:.1f} GB)"), xalign=0.0))
                    except OSError:
                        continue

        def update_live():
            now = time.monotonic(); elapsed = max(now - previous_time[0], 0.1); previous_time[0] = now
            current = read_cpu(); old = previous_cpu[0]; previous_cpu[0] = current
            if old:
                usages = []
                for key in ["cpu"] + [f"cpu{i}" for i in range(cpu_count)]:
                    total, idle = current.get(key, (0, 0)); ototal, oidle = old.get(key, (total, idle))
                    dt, di = total - ototal, idle - oidle
                    usages.append(max(0.0, min(100.0, 100.0 * (dt - di) / dt)) if dt else 0.0)
                for hist, value in zip(cpu_area._aurora_history, usages): hist.append(value); del hist[:-60]
                cpu_area.queue_draw(); cpu_label.set_text("Totaal: %.1f%%   |   " % usages[0] + "   ".join(f"Core{i}: {v:.1f}%" for i, v in enumerate(usages[1:])))
            mem_used = read_mem(); mem_area._aurora_history[0].append(mem_used); del mem_area._aurora_history[0][:-60]
            try: root_used = 100.0 * (1.0 - shutil.disk_usage("/").free / shutil.disk_usage("/").total)
            except OSError: root_used = 0.0
            mem_area._aurora_history[1].append(root_used); del mem_area._aurora_history[1][:-60]; mem_area.queue_draw()
            mem_label.set_text(f"RAM gebruikt: {mem_used:.1f}%   |   Root-opslag gebruikt: {root_used:.1f}%")
            disk = read_disk_io(); old_disk = previous_disk[0]; previous_disk[0] = disk
            if old_disk:
                read_rate, write_rate = max(0, disk[0] - old_disk[0]) / elapsed, max(0, disk[1] - old_disk[1]) / elapsed
                for hist, val in zip(disk_area._aurora_history, (read_rate, write_rate)): hist.append(val); del hist[:-60]
                disk_area.queue_draw(); disk_label.set_text(f"Lezen: {read_rate / 1048576:.2f} MiB/s   |   Schrijven: {write_rate / 1048576:.2f} MiB/s")
            return True

        refresh_devices(); GLib.timeout_add(1000, update_live)
        live_card.get_last_child().append(live_box)
        box.append(live_card)

        # ── Aurora AI Needle onderhoudsmanager ──────────────────────────────
        ai_card = self.create_card_group(
