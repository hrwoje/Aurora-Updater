                run_admin_cmd("sysctl-apply", "vm.dirty_ratio", "10")
                run_admin_cmd("sysctl-apply", "vm.dirty_background_ratio", "5")
                run_admin_cmd("sysctl-apply", "vm.vfs_cache_pressure", "50")
            else:
                run_admin_cmd("sysctl-apply", "vm.dirty_ratio", "20")
                run_admin_cmd("sysctl-apply", "vm.dirty_background_ratio", "10")
