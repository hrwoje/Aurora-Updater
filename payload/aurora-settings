        box.set_margin_top(20); box.set_margin_bottom(20); box.set_margin_start(24); box.set_margin_end(24)
        box.append(self.create_page_header("Opslaganalyse", "Bekijk waar lokale en aangekoppelde netwerkschijven ruimte gebruiken", "drive-harddisk-symbolic"))

        card = self.create_card_group("Schijf- en mapanalyse", "Een echte WinDirStat-achtige scan zonder bestanden te wijzigen")
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        mounts = []
        try:
            mount_res = run_cmd("findmnt", "-J", "-o", "TARGET,SOURCE,FSTYPE", timeout=10)
            tree = json.loads(mount_res.stdout) if mount_res and mount_res.returncode == 0 else {}
            def walk_mounts(items):
                for item in items:
                    yield item
                    yield from walk_mounts(item.get("children", []))
            for item in walk_mounts(tree.get("filesystems", [])):
                target = item.get("target", ""); source = item.get("source", ""); fstype = item.get("fstype", "")
                if target.startswith(("/proc", "/sys", "/dev", "/run")): continue
                if target and os.path.isdir(target): mounts.append((target, source, fstype))
        except (OSError, ValueError, TypeError):
            pass
        if not any(m[0] == "/" for m in mounts): mounts.insert(0, ("/", "root", "unknown"))
        labels = [f"{target} — {source} ({fstype})" for target, source, fstype in mounts]
        mount_drop = Gtk.DropDown.new_from_strings(labels)
        mount_drop.set_hexpand(True)
        scan_btn = Gtk.Button(label="Scan starten")
        scan_btn.add_css_class("suggested-action")
        stop_btn = Gtk.Button(label="Stoppen")
        stop_btn.set_sensitive(False)
        controls.append(mount_drop); controls.append(scan_btn); controls.append(stop_btn)
        card.get_last_child().append(controls)
        status = Gtk.Label(label="Kies een schijf of netwerkmount en start een scan.", xalign=0.0, wrap=True)
        card.get_last_child().append(status)
        progress = Gtk.ProgressBar(); progress.set_show_text(True); progress.set_hexpand(True)
        card.get_last_child().append(progress)

        result_scroll = Gtk.ScrolledWindow(); result_scroll.set_min_content_height(360)
        result_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        result_box.append(Gtk.Label(label="Nog geen scan uitgevoerd.", xalign=0.0))
        result_scroll.set_child(result_box); card.get_last_child().append(result_scroll)
        box.append(card)

        largest_card = self.create_card_group("Grootste bestanden", "Bestanden worden alleen gelezen; verwijderen gebeurt nergens automatisch")
        largest_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        largest_card.get_last_child().append(largest_box); box.append(largest_card)

        scan_state = {"stop": False, "running": False}
        def size_label(value):
            units = ("B", "KiB", "MiB", "GiB", "TiB"); n = float(value); idx = 0
            while n >= 1024 and idx < len(units) - 1: n /= 1024; idx += 1
            return f"{n:.1f} {units[idx]}"

        def render_results(items, total, files, dirs, errors, largest, target):
            while child := result_box.get_first_child(): result_box.remove(child)
            while child := largest_box.get_first_child(): largest_box.remove(child)
            status.set_text(f"Scan voltooid: {files} bestanden, {dirs} mappen, {errors} toegangsproblemen — {size_label(total)} in {target}")
            progress.set_fraction(1.0); progress.set_text("Klaar")
            peak = max((x[1] for x in items), default=1)
            for path, amount in items[:80]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                lbl = Gtk.Label(label=esc(path), xalign=0.0); lbl.set_hexpand(True); lbl.set_ellipsize(3)
                row.append(lbl)
                bar = Gtk.ProgressBar(); bar.set_fraction(min(1.0, amount / peak)); bar.set_text(size_label(amount)); bar.set_show_text(True); bar.set_size_request(220, -1)
                row.append(bar); result_box.append(row)
            if not largest:
                largest_box.append(Gtk.Label(label="Geen bestanden gevonden.", xalign=0.0))
            for path, amount in largest[:30]:
                largest_box.append(Gtk.Label(label=esc(f"{size_label(amount):>10}  {path}"), xalign=0.0))

        def start_scan(button):
            if scan_state["running"]: return
            idx = mount_drop.get_selected(); target = mounts[idx][0] if 0 <= idx < len(mounts) else "/"
            scan_state.update(stop=False, running=True); scan_btn.set_sensitive(False); stop_btn.set_sensitive(True); progress.set_fraction(0.0); progress.set_text("Scannen…")
            while child := result_box.get_first_child(): result_box.remove(child)
            def worker():
                sizes = {}; total = files = dirs = errors = 0; largest = []
                try:
                    for root, dirnames, filenames in os.walk(target, topdown=True, followlinks=False):
                        if scan_state["stop"]: break
                        dirnames[:] = [d for d in dirnames if not os.path.islink(os.path.join(root, d))]
                        dirs += len(dirnames)
                        for filename in filenames:
                            if scan_state["stop"]: break
                            path = os.path.join(root, filename)
                            try:
                                amount = os.path.getsize(path); total += amount; files += 1
                                relative = os.path.relpath(root, target); key = target if relative == "." else os.path.join(target, relative.split(os.sep)[0])
                                sizes[key] = sizes.get(key, 0) + amount
                                largest.append((path, amount))
                            except (OSError, ValueError): errors += 1
                except Exception:
                    errors += 1
                items = sorted(sizes.items(), key=lambda x: x[1], reverse=True); largest.sort(key=lambda x: x[1], reverse=True)
                GLib.idle_add(render_results, items, total, files, dirs, errors, largest, target)
                GLib.idle_add(lambda: (scan_state.update(running=False), scan_btn.set_sensitive(True), stop_btn.set_sensitive(False), False)[-1])
            threading.Thread(target=worker, daemon=True).start()
        def stop_scan(button): scan_state["stop"] = True; status.set_text("Scan wordt gestopt…"); stop_btn.set_sensitive(False)
        scan_btn.connect("clicked", start_scan); stop_btn.connect("clicked", stop_scan)
        GLib.idle_add(lambda: (start_scan(scan_btn), False)[-1])
        return scrolled

