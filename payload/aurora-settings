        )
        live_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        def line_graph(width, height, colors, fixed_max=100.0):
            area = Gtk.DrawingArea(); area.set_content_width(width); area.set_content_height(height); area.set_hexpand(True)
            history = [[] for _ in colors]
            def draw(area, cr, w, h):
                cr.set_source_rgb(0.07, 0.08, 0.10); cr.paint()
                cr.set_source_rgba(0.45, 0.48, 0.55, 0.25); cr.set_line_width(1)
                for y in range(1, 5):
                    yy = h * y / 5; cr.move_to(0, yy); cr.line_to(w, yy); cr.stroke()
                peak = fixed_max or max((max(values) if values else 0) for values in history) or 1.0
                for values, color in zip(history, colors):
                    if len(values) < 2: continue
                    cr.set_source_rgba(*color); cr.set_line_width(1.6)
                    for i, value in enumerate(values):
                        x = i * w / max(len(values) - 1, 1); y = h - (min(value, peak) / peak) * (h - 12) - 6
                        if i == 0: cr.move_to(x, y)
                        else: cr.line_to(x, y)
                    cr.stroke()
            area.set_draw_func(draw)
            area._aurora_history = history
            return area

        cpu_count = max(1, int(os.cpu_count() or 1))
        cpu_colors = [(0.25, 0.75, 1.0, 0.95)] + [((0.35 + (i % 4) * 0.12), 0.9 - (i % 3) * 0.12, 0.45 + (i % 2) * 0.25, 0.72) for i in range(cpu_count)]
        cpu_area = line_graph(760, 210, cpu_colors)
        cpu_title = Gtk.Label(label="<b>CPU totaal en per core</b>", use_markup=True, xalign=0.0)
        cpu_label = Gtk.Label(label="Meten…", xalign=0.0); cpu_label.add_css_class("monospace")
        live_box.append(cpu_title); live_box.append(cpu_area); live_box.append(cpu_label)

        mem_area = line_graph(760, 170, [(0.95, 0.65, 0.2, 0.95), (0.65, 0.45, 1.0, 0.9)])
        mem_title = Gtk.Label(label="<b>RAM en root-opslag gebruikt (%)</b>", use_markup=True, xalign=0.0)
        mem_label = Gtk.Label(label="Meten…", xalign=0.0); mem_label.add_css_class("monospace")
        live_box.append(mem_title); live_box.append(mem_area); live_box.append(mem_label)

        disk_area = line_graph(760, 150, [(0.3, 0.75, 1.0, 0.9), (0.95, 0.4, 0.3, 0.9)], fixed_max=None)
