                            btn_in.add_css_class("suggested-action")
                            btn_in.connect("clicked", lambda b, p=pname: do_pkg_action("install", p))
                            row.append(btn_in)

                        results_list.append(row)
                        results_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

                GLib.idle_add(update_ui)

            threading.Thread(target=worker, daemon=True).start()

        search_btn.connect("clicked", lambda b: do_search())
        search_entry.connect("activate", lambda e: do_search())

        # Geïnstalleerde software logica
        all_installed = []
        def refresh_installed():
            while child := inst_list.get_first_child():
                inst_list.remove(child)

            def worker():
                res = run_cmd("xbps-query", "-m")
                pkgs = []
                if res and res.stdout:
                    for line in res.stdout.splitlines():
                        if line.strip():
                            pname = re.sub(r"-[^-]+$", "", line.strip())
                            pkgs.append((pname, line.strip()))
                pkgs.sort(key=lambda x: x[0])
                nonlocal all_installed
                all_installed = pkgs

                def update_ui():
                    render_installed(all_installed)
                GLib.idle_add(update_ui)

            threading.Thread(target=worker, daemon=True).start()

        def render_installed(pkgs):
            while child := inst_list.get_first_child():
                inst_list.remove(child)
            filt = inst_filter.get_text().strip().lower()
            filtered = [p for p in pkgs if filt in p[0].lower() or filt in p[1].lower()] if filt else pkgs
            
            for pname, pver in filtered[:100]:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                lbl = Gtk.Label(label=f"<b>{esc(pname)}</b> ({esc(pver)})", use_markup=True, xalign=0.0)
                lbl.set_hexpand(True)
                row.append(lbl)

                btn_del = Gtk.Button(label="Verwijderen")
                btn_del.add_css_class("destructive-action")
                btn_del.connect("clicked", lambda b, p=pname: do_pkg_action("remove", p))
                row.append(btn_del)

                inst_list.append(row)
                inst_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        inst_filter.connect("search-changed", lambda e: render_installed(all_installed))
        btn_refresh_inst.connect("clicked", lambda b: refresh_installed())
        refresh_installed()

        def do_pkg_action(action, pkg):
            append_log(f"--- Bezig met {action} van {pkg} via aurora-system-admin ---")
            def worker():
                if action == "install":
                    res = run_admin_cmd("pkg-install", pkg, timeout=180)
                else:
                    res = run_admin_cmd("pkg-remove", pkg, timeout=180)
                out = res.stdout if res and res.stdout else "Geen uitvoer."
                err = res.stderr if res and res.stderr else ""
                GLib.idle_add(lambda: (append_log(out + ("\n" + err if err else "")), refresh_installed(), do_search()))
            threading.Thread(target=worker, daemon=True).start()

        scrolled.set_child(box)
        return scrolled

