        night_slider.connect("value-changed", night_temperature_changed)
        if setting("display.nightlight", False):
            subprocess.Popen(["wlsunset", "-t", str(int(night_adj.get_value())), "-T", "6500"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        night_card.get_last_child().append(night_grid)
        box.append(night_card)

        # HDR Ondersteuning
        hdr_card = self.create_card_group("HDR & Kleurruimte", "High Dynamic Range en breed kleurenbereik (WCG)")
