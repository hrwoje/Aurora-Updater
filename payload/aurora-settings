        def scan_lan_devices(b):
            btn_scan_lan.set_sensitive(False)
            lan_spinner.start()
            lan_status.set_text("Lokaal netwerk scannen en apparaten identificeren...")
            while child := lan_list.get_first_child():
                lan_list.remove(child)

            def worker():
                # 1. Gateway & Subnet ophalen
                gateway = None
                dev = None
                rt = run_cmd("ip", "route")
                if rt and rt.stdout:
                    for line in rt.stdout.splitlines():
                        if line.startswith("default"):
                            p = line.split()
                            gateway = p[2]
                            dev = p[4]
                            break

                loc_ip = None
                if dev:
                    addr_res = run_cmd("ip", "-4", "addr", "show", dev)
                    if addr_res and addr_res.stdout:
                        for line in addr_res.stdout.splitlines():
                            line = line.strip()
                            if line.startswith("inet "):
                                loc_ip = line.split()[1].split("/")[0]
                                break

                # 2. Parallelle sweep om ARP-tabel aan te vullen
                if loc_ip:
                    prefix = ".".join(loc_ip.split(".")[:3])
                    def ping_dev(ip):
                        subprocess.run(["ping", "-c", "1", "-W", "1", ip], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    threads = [threading.Thread(target=ping_dev, args=(f"{prefix}.{i}",)) for i in range(1, 255)]
                    for t in threads: t.start()
                    for t in threads: t.join(timeout=1.6)

                # 3. SSDP M-SEARCH voor UPnP/Chromecast/Smart TV info
                ssdp_map = {}
                try:
                    s_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
                    s_sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
                    s_sock.settimeout(1.2)
                    m_msg = ('M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: "ssdp:discover"\r\nMX: 1\r\nST: ssdp:all\r\n\r\n').encode()
                    s_sock.sendto(m_msg, ('239.255.255.250', 1900))
                    while True:
                        try:
                            data, addr = s_sock.recvfrom(4096)
                            txt = data.decode(errors="ignore")
                            srv = re.search(r'SERVER:\s*(.*)', txt, re.I)
                            if srv: ssdp_map[addr[0]] = srv.group(1).strip()
                        except socket.timeout:
                            break
                        except Exception:
                            break
                    s_sock.close()
                except Exception:
                    pass

                # 4. ARP-tabel lezen
                discovered = []
                try:
                    with open("/proc/net/arp") as f:
                        for line in f.readlines()[1:]:
                            p = line.split()
                            if len(p) >= 6 and p[3] != "00:00:00:00:00:00":
                                d_ip = p[0]
                                d_mac = p[3].lower()
                                
                                # Vendor OUI lookup
                                prefix3 = ":".join(d_mac.split(":")[:3])
                                vendor, dev_type = COMMON_OUIs.get(prefix3, ("Onbekend", "💻 Netwerkapparaat"))
                                
                                if d_ip == gateway:
                                    dev_type = "🌐 Modem / Gateway (Router)"
                                elif d_ip in ssdp_map:
                                    if "Chromecast" in ssdp_map[d_ip]:
                                        dev_type = "📺 Chromecast / Google TV"
                                    else:
                                        dev_type = f"📺 Smart TV / UPnP ({ssdp_map[d_ip][:30]})"

                                # Snelle servicecontrole voor gangbare apparaten.
                                open_ports = []
                                port_names = {22: "SSH", 23: "Telnet", 53: "DNS", 80: "HTTP", 443: "HTTPS", 445: "SMB", 631: "IPP-printer", 8008: "Chromecast", 8080: "HTTP-alt", 8443: "HTTPS-alt", 554: "RTSP-camera"}
                                for port in port_names:
                                    try:
                                        c = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                                        c.settimeout(0.15)
                                        if c.connect_ex((d_ip, port)) == 0:
                                            open_ports.append(f"{port}/{port_names[port]}")
                                            c.close()
                                        c.close()
                                    except Exception:
                                        pass

                                discovered.append((d_ip, d_mac, vendor, dev_type, open_ports))
                except Exception:
                    pass

                discovered.sort(key=lambda x: [int(v) for v in x[0].split(".") if v.isdigit()])

                def ui_done():
                    lan_spinner.stop()
                    btn_scan_lan.set_sensitive(True)
                    lan_status.set_text(f"Scan voltooid: {len(discovered)} apparaat(en) gedetecteerd op het netwerk.")
                    
                    for dip, dmac, dvendor, dtype, open_ports in discovered:
                        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                        
                        info_b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                        info_b.set_hexpand(True)
                        info_b.append(Gtk.Label(label=f"<b>{esc(dtype)}</b> — {esc(dip)}", use_markup=True, xalign=0.0))
                        port_text = ", ".join(open_ports) if open_ports else "geen bekende open poorten"
                        info_b.append(Gtk.Label(label=f"<span size='small' alpha='75%'>Fabrikant: {esc(dvendor)} | MAC: {esc(dmac)} | Poorten: {esc(port_text)}</span>", use_markup=True, xalign=0.0))
                        row.append(info_b)

                        if any(p.startswith(("80/", "443/", "8080/", "8443/")) for p in open_ports):
                            btn_web = Gtk.Button(label="🌐 Open in browser")
                            btn_web.connect("clicked", lambda b, ip=dip: subprocess.Popen(["xdg-open", f"http://{ip}"]))
                            row.append(btn_web)

                        lan_list.append(row)
                        lan_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

                GLib.idle_add(ui_done)

            threading.Thread(target=worker, daemon=True).start()

        btn_scan_lan.connect("clicked", scan_lan_devices)
        box.append(lan_card)

        # ── Unbound DNSSEC Resolver Card ─────────────────────────────────────
        dns_card = self.create_card_group("Unbound DNSSEC Resolver", "Lokaal validerende DNS met ingebouwde encryptie")
        dns_status_lbl = Gtk.Label(label="Status: Draait lokaal op 127.0.0.1 (poort 53)")
        dns_status_lbl.set_xalign(0.0)
        dns_card.get_last_child().append(dns_status_lbl)

        dns_grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        dns4 = Gtk.Entry(); dns4.set_hexpand(True)
