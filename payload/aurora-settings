        return
    provider = Gtk.CssProvider()
    provider.load_from_data(b"""
        /* Consistent controls; this provider is local to Aurora Settings. */
        switch {
            min-width: 42px;
            min-height: 22px;
            padding: 2px;
            border-radius: 4px;
        }
        switch slider {
            min-width: 18px;
            min-height: 18px;
            border-radius: 3px;
        }
        switch:checked {
            min-width: 42px;
        }
        switch:checked slider {
            border-radius: 3px;
        }
        button {
            min-height: 32px;
            padding: 6px 12px;
        }
        dropdown > button, combobox > button {
