                    f"PrivateKey = {entries['privkey'].get_text().strip()}\n"
                    f"Address = {entries['address'].get_text().strip()}\n"
                    f"DNS = {entries['dns'].get_text().strip()}\n\n"
                    f"[Peer]\n"
                    f"PublicKey = {entries['pubkey'].get_text().strip()}\n"
                    f"Endpoint = {entries['endpoint'].get_text().strip()}\n"
                    f"AllowedIPs = {entries['allowed'].get_text().strip() or '0.0.0.0/0'}\n"
