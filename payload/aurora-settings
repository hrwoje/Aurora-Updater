        ai_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        ai_enabled = aurora_switch(); ai_enabled.set_active(bool(setting("ai.manager.enabled", False)))
        ai_row.append(Gtk.Label(label="AI-manager inschakelen", xalign=0.0)); ai_row.append(ai_enabled)
        ai_mode = Gtk.DropDown.new_from_strings(["Alleen controleren en rapporteren", "Veilig onderhoud automatisch uitvoeren"])
        ai_mode.set_selected(1 if setting("ai.manager.mode", "monitor") == "maintenance" else 0)
        ai_row.append(ai_mode); ai_box.append(ai_row)
        ai_status = Gtk.Label(label="Uitgeschakeld" if not ai_enabled.get_active() else "Ingeschakeld", xalign=0.0, wrap=True)
        ai_box.append(ai_status)
        ai_actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
