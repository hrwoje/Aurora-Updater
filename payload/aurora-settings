        # ── Netwerk Apparaten Scanner (LAN Discovery) Card ───────────────────
        lan_card = self.create_card_group("Netwerk Apparaten Scanner (LAN)", "Ontdek alle apparaten op je lokale netwerk (modems, TV's, printers, camera's, lampen, telefoons)")
        lan_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
