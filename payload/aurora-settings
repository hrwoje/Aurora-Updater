        # Live netwerkmonitor: kernelinterface-tellers voor de grafiek en ss
        # voor echte actieve IP/poortverbindingen. Er wordt niets verzonnen.
        net_card = self.create_card_group(
            "Realtime netwerkmonitor",
            "Live inkomend/uitgaand verkeer en actieve IP-verbindingen uit de kernel",
        )
        net_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        graph = Gtk.DrawingArea()
        graph.set_content_width(760); graph.set_content_height(190)
        graph.set_hexpand(True)
        samples_rx, samples_tx = [], []
        traffic_label = Gtk.Label(label="Wachten op netwerkmeting…", xalign=0.0)
        traffic_label.add_css_class("monospace")

        def draw_graph(area, cr, width, height):
            cr.set_source_rgb(0.08, 0.09, 0.11); cr.paint()
            cr.set_line_width(1.0); cr.set_source_rgba(0.45, 0.48, 0.55, 0.25)
            for y in range(1, 5):
                yy = height * y / 5
                cr.move_to(0, yy); cr.line_to(width, yy); cr.stroke()
            def series(values, color):
                if len(values) < 2: return
                peak = max(max(values), 1.0)
                cr.set_source_rgba(*color); cr.set_line_width(2.0)
                for i, value in enumerate(values):
                    x = i * width / max(len(values) - 1, 1)
                    y = height - (value / peak) * (height - 12) - 6
                    if i == 0: cr.move_to(x, y)
                    else: cr.line_to(x, y)
                cr.stroke()
            series(samples_rx, (0.25, 0.75, 1.0, 0.95))
            series(samples_tx, (0.35, 0.9, 0.45, 0.95))

        graph.set_draw_func(draw_graph)
        net_box.append(graph)
        net_box.append(Gtk.Label(label="Blauw = inkomend (RX)   Groen = uitgaand (TX)", xalign=0.0))
