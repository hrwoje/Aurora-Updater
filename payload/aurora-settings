        disp_card = self.create_card_group("Beeldschermweergave", "Instellingen voor aangesloten monitoren")
        grid = Gtk.Grid(column_spacing=14, row_spacing=10)

        niri_res = run_cmd("niri", "msg", "-j", "outputs")
        outputs = []
        try:
            parsed = json.loads(niri_res.stdout) if niri_res and niri_res.stdout else []
            outputs = parsed if isinstance(parsed, list) else list(parsed.values())
        except Exception:
            outputs = []

        def persist_output(name, mode=None, scale=None, vrr=None):
            cfg = os.path.expanduser("~/.config/niri/config.kdl")
            if not os.path.exists(cfg): return
            try:
                txt = open(cfg, encoding="utf-8").read()
                pat = re.compile(r'^output\s+"' + re.escape(name) + r'"\s*\{.*?^\}\s*', re.M | re.S)
                existing = pat.search(txt)
                if existing:
                    old = existing.group(0)
                    if mode is None:
                        m = re.search(r'\bmode\s+"([^"]+)"\s*;', old)
                        mode = m.group(1) if m else None
                    if scale is None:
                        m = re.search(r'\bscale\s+([0-9.]+)\s*;', old)
                        scale = m.group(1) if m else None
                    if vrr is None:
                        m = re.search(r'\bvrr\s+(on|off)\s*;', old)
                        vrr = (m.group(1) == "on") if m else None
                body = []
                if mode: body.append(f'    mode "{mode}";')
                if scale: body.append(f"    scale {scale};")
                if vrr is not None: body.append(f"    vrr {'on' if vrr else 'off'};")
                block = f'output "{name}" {{\n' + "\n".join(body) + "\n}\n"
                txt = pat.sub(block, txt, count=1) if pat.search(txt) else txt.rstrip() + "\n\n" + block
                with open(cfg, "w", encoding="utf-8") as fh: fh.write(txt)
                run_cmd("niri", "msg", "action", "load-config-file")
            except Exception:
                pass

        grid.attach(Gtk.Label(label="<b>Aangesloten monitoren en echte modi:</b>", use_markup=True, xalign=0.0), 0, 0, 2, 1)
        if outputs:
            row_idx = 1
            for out in outputs:
                name = str(out.get("name", "onbekend"))
                current = out.get("current_mode") or {}
                modes = out.get("modes") or []
                mode_values = []
                for m in modes:
                    try:
                        w, h = int(m.get("width")), int(m.get("height"))
                        rr = float(m.get("refresh_rate", 60000)) / 1000
                        mode_values.append((f"{w}x{h}@{rr:g}", m))
                    except Exception:
                        continue
                label = Gtk.Label(label=f"<b>{esc(name)}</b> — {esc(str(out.get('make', '')))} {esc(str(out.get('model', '')))}", use_markup=True, xalign=0.0)
                label.set_hexpand(True)
                grid.attach(label, 0, row_idx, 1, 1)
                mode_list = Gtk.StringList(); mode_keys = []
                for key, _ in mode_values: mode_list.append(key); mode_keys.append(key)
                mode_drop = Gtk.DropDown(model=mode_list)
                current_key = ""
                if current:
                    try: current_key = f"{int(current['width'])}x{int(current['height'])}@{float(current['refresh_rate'])/1000:g}"
                    except Exception: pass
                for i, key in enumerate(mode_keys):
                    if key == current_key: mode_drop.set_selected(i); break
                apply_mode = Gtk.Button(label="Toepassen")
                def apply_output(b, output=name, dropdown=mode_drop, keys=mode_keys):
                    idx = dropdown.get_selected()
                    if 0 <= idx < len(keys):
                        selected = keys[idx]
                        res = run_cmd("niri", "msg", "output", output, "mode", selected)
                        if res and res.returncode == 0:
                            persist_output(output, mode=selected)
                            b.set_label("Toegepast")
                        else:
                            b.set_label("Mislukt")
                apply_mode.connect("clicked", apply_output)
                grid.attach(mode_drop, 1, row_idx, 1, 1); grid.attach(apply_mode, 2, row_idx, 1, 1)
                if out.get("vrr_supported"):
                    vrr_switch = aurora_switch(); vrr_switch.set_active(bool(setting("display.vrr." + name, False)))
                    vrr_switch.connect("state-set", lambda s, state, output=name: (run_cmd("niri", "msg", "output", output, "vrr", "on" if state else "off"), persist_output(output, vrr=bool(state)), set_setting("display.vrr." + output, bool(state)), False)[-1])
                    grid.attach(vrr_switch, 3, row_idx, 1, 1)
                row_idx += 1
            grid.attach(Gtk.Label(label="<b>Schaal actieve monitor:</b>", use_markup=True, xalign=0.0), 0, row_idx, 1, 1)
            scale_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            for factor in ("1.0", "1.25", "1.5", "2.0"):
                btn = Gtk.Button(label=f"{int(float(factor)*100)}%")
                btn.connect("clicked", lambda b, f=factor: (set_setting("display.scale", f), run_cmd("niri", "msg", "action", "scale-view", f)))
                scale_box.append(btn)
            grid.attach(scale_box, 1, row_idx, 2, 1)
        else:
            fallback = niri_res.stdout if niri_res and niri_res.stdout else "Geen actieve monitorinformatie; Niri-socket niet bereikbaar."
            fallback_lbl = Gtk.Label(label=esc(fallback), xalign=0.0); fallback_lbl.add_css_class("monospace")
            grid.attach(fallback_lbl, 0, 1, 3, 1)

        disp_card.get_last_child().append(grid)
        box.append(disp_card)

        # Nachtstand & Kleurtemperatuur
