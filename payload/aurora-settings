    def build_vpn_page(self):
        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(20); box.set_margin_bottom(20); box.set_margin_start(24); box.set_margin_end(24)
        box.append(self.create_page_header("VPN-beheer", "Stel beveiligde WireGuard en OpenVPN verbindingen in via bestanden of handmatige instellingen", "network-vpn-symbolic"))

        vpn_card = self.create_card_group("VPN Verbindingen", "Geïmporteerde en geconfigureerde WireGuard-tunnels")
        btn_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_import = Gtk.Button(label="📂 VPN-bestand importeren (.conf / .ovpn)")
        btn_manual = Gtk.Button(label="➕ Handmatig WireGuard toevoegen")
        btn_bar.append(btn_import)
        btn_bar.append(btn_manual)
        vpn_card.get_last_child().append(btn_bar)

        tunnels_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        tunnels_list.set_margin_top(12)
        vpn_card.get_last_child().append(tunnels_list)
        box.append(vpn_card)

        def refresh_tunnels():
            while child := tunnels_list.get_first_child():
                tunnels_list.remove(child)

            confs = glob.glob("/etc/wireguard/*.conf")
            wg_active = (run_cmd("wg", "show").stdout if run_cmd("wg", "show") else "")

            if not confs:
                tunnels_list.append(Gtk.Label(label="Geen VPN-configuraties gevonden. Importeer een .conf bestand of voeg handmatig een tunnel toe.", xalign=0.0))
                return

            for cf in confs:
