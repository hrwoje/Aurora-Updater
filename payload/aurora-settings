    # ── 16. Kernel & Drivers Pagina ─────────────────────────────────────────
    def build_hardware_page(self):
        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(20); box.set_margin_bottom(20); box.set_margin_start(24); box.set_margin_end(24)
        box.append(self.create_page_header("Kernel, Drivers & Hardware", "Kernelbeheer, systeemprestaties (sysctl), driverinstallatie en apparaten", "drive-harddisk-symbolic"))

        # ── Real-time inventory ─────────────────────────────────────────────
        audit_card = self.create_card_group("Werkelijke systeemstatus", "Rechtstreeks gelezen uit /boot, /lib/modules, XBPS en PCI-kernelinformatie")
        audit_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        kernel_rows = kernel_inventory()
        pkg_kernels = [p for p in installed_packages(("linux",)) if re.match(r"linux(?:[0-9]|-)", p)]
        active_row = next((x for x in kernel_rows if x["active"]), None)
        audit_box.append(Gtk.Label(label=f"<b>Actieve kernel:</b> {esc(active_row['version'] if active_row else platform.release())}", use_markup=True, xalign=0.0))
        audit_box.append(Gtk.Label(label=f"<b>Boot-images:</b> {len(kernel_rows)} | <b>Kernelpakketten:</b> {len(pkg_kernels)}", use_markup=True, xalign=0.0))
        if active_row and not active_row.get("package"):
            audit_box.append(Gtk.Label(label="<b>Let op:</b> de actieve kernel staat als image/modules op disk maar heeft geen overeenkomend geïnstalleerd XBPS-pakket. Start na een normale reboot de nieuwste geïnstalleerde kernel om deze toestand te normaliseren.", use_markup=True, xalign=0.0, wrap=True))
        for item in kernel_rows:
            flags = "actief" if item["active"] else "reserve"
            flags += ", modules OK" if item["modules"] else ", modules ontbreken"
            flags += ", initramfs OK" if item["initramfs"] else ", initramfs ontbreekt"
            audit_box.append(Gtk.Label(label=f"  {esc(item['version'])}: {esc(flags)}", xalign=0.0))
        drivers = driver_inventory()
        if drivers:
            for drv in drivers:
                audit_box.append(Gtk.Label(label=f"<b>{esc(drv['device'])}</b> — driver: {esc(drv['driver'])}", use_markup=True, xalign=0.0))
        else:
            audit_box.append(Gtk.Label(label="PCI-driverinformatie niet beschikbaar.", xalign=0.0))
        fw = run_cmd("fwupdmgr", "get-devices", timeout=25)
        fw_text = "fwupd-apparaten konden niet worden gelezen."
        if fw and fw.returncode == 0:
            lines = [l.strip() for l in fw.stdout.splitlines() if l.strip()]
            fw_text = f"fwupd gelezen: {len(lines)} informatielijnen; controleerbare apparaten worden hieronder bijgewerkt."
        audit_box.append(Gtk.Label(label=esc(fw_text), xalign=0.0))
        audit_card.get_last_child().append(audit_box)
        box.append(audit_card)

        # ── Kernelbeheer & Keuzelijst Card ───────────────────────────────────
        k_card = self.create_card_group("Linux Kernels & Beheer", "Selecteer, installeer of verwijder Linux kernels uit het Void-archief")
        k_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        cur_k = platform.release()
        k_box.append(Gtk.Label(label=f"Actief draaiende kernel: <b>{esc(cur_k)}</b>", use_markup=True, xalign=0.0))

        k_list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        k_box.append(k_list_box)

        btn_k_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_refresh_k = Gtk.Button(label="Kernels Verversen")
        btn_purge_k = Gtk.Button(label="🧹 Oude kernels opruimen (vkpurge)")
        btn_purge_k.add_css_class("destructive-action")
        btn_k_row.append(btn_refresh_k)
        btn_k_row.append(btn_purge_k)
        k_box.append(btn_k_row)

        available_kernels = []
        repo_kernels = run_cmd("xbps-query", "-Rs", "^linux([0-9]|-lts)", timeout=20)
        if repo_kernels and repo_kernels.returncode == 0:
            seen = set()
            for line in repo_kernels.stdout.splitlines():
                match = re.search(r"\] (linux[^ -]+(?:-lts)?)(?:-[0-9])", line)
                if not match: continue
                pkg = match.group(1)
                if pkg in seen or pkg.endswith("-headers"): continue
                seen.add(pkg)
                available_kernels.append((pkg, f"Repositorypakket {pkg} (live XBPS-gegevens)", pkg.replace("linux", "")))
        for item in kernel_inventory():
            pkg = item.get("package", "")
            if pkg:
                base = re.match(r"(linux[^-]+)", pkg)
                if base and not any(x[0] == base.group(1) for x in available_kernels):
                    available_kernels.append((base.group(1), f"Geïnstalleerd: {base.group(1)}", base.group(1).replace("linux", "")))

        def refresh_kernels():
            while child := k_list_box.get_first_child():
                k_list_box.remove(child)

            inst_files = glob.glob("/boot/vmlinuz-*")
            inst_vers = [os.path.basename(f).replace("vmlinuz-", "") for f in inst_files]

            for kpkg, kdesc, kseries in available_kernels:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                is_installed = any(kseries in v for v in inst_vers) or (run_cmd("xbps-query", "-s", kpkg) and run_cmd("xbps-query", "-s", kpkg).returncode == 0)
                
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                info.set_hexpand(True)
                info.append(Gtk.Label(label=f"<b>{esc(kpkg)}</b> — {esc(kdesc)}", use_markup=True, xalign=0.0))
                status_k_txt = "Geïnstalleerd" if is_installed else "Beschikbaar in repository"
                info.append(Gtk.Label(label=f"<span size='small' alpha='75%'>Status: {status_k_txt}</span>", use_markup=True, xalign=0.0))
                row.append(info)

                if is_installed:
                    btn_rm_k = Gtk.Button(label="Verwijderen")
                    btn_rm_k.add_css_class("destructive-action")
                    btn_rm_k.connect("clicked", lambda b, k=kpkg: (run_admin_cmd("kernel-remove", k), refresh_kernels()))
                    row.append(btn_rm_k)
                else:
                    btn_in_k = Gtk.Button(label="Installeren")
                    btn_in_k.add_css_class("suggested-action")
                    btn_in_k.connect("clicked", lambda b, k=kpkg: (run_admin_cmd("kernel-install", k), refresh_kernels()))
                    row.append(btn_in_k)

                k_list_box.append(row)
                k_list_box.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        btn_refresh_k.connect("clicked", lambda b: refresh_kernels())
        btn_purge_k.connect("clicked", lambda b: (run_admin_cmd("kernel-purge"), refresh_kernels()))
        refresh_kernels()

        k_card.get_last_child().append(k_box)
        box.append(k_card)

        # ── Kernel Optimalisaties & Sysctl Card ──────────────────────────────
        sysctl_card = self.create_card_group("Kernel-optimalisaties & Prestaties (Sysctl)", "Fine-tuning parameters voor lagere latency, soepele I/O en gaming")
        sysctl_grid = Gtk.Grid(column_spacing=14, row_spacing=10)

        # Tweak 1: Gaming / Low latency
        sw_game = aurora_switch()
        game_keys = (
            "net.ipv4.tcp_congestion_control",
            "net.core.default_qdisc",
            "vm.swappiness",
            "kernel.sched_autogroup_enabled",
        )
        game_values = {key: sysctl_value(key) for key in game_keys}
        game_supported = all(game_values.values())
        game_live = game_supported and (
            game_values["net.ipv4.tcp_congestion_control"] == "bbr"
            and game_values["net.core.default_qdisc"] == "fq"
            and game_values["vm.swappiness"] == "10"
            and game_values["kernel.sched_autogroup_enabled"] == "1"
        )
        sw_game.set_active(game_live)
        sw_game.set_sensitive(game_supported)
        if not game_supported:
            sw_game.set_tooltip_text("Niet beschikbaar: deze kernel biedt niet alle benodigde sysctl-sleutels")
        sysctl_grid.attach(Gtk.Label(label="<b>Lage Latency &amp; Gaming Modus:</b>\n<span size='small'>Schakelt BBR TCP Congestion Control, autogrouping en swappiness=10 in</span>", use_markup=True, xalign=0.0), 0, 0, 1, 1)
        sysctl_grid.attach(sw_game, 1, 0, 1, 1)

        # Tweak 2: I/O Stutter preventie
        sw_io = aurora_switch()
        io_live = (
            sysctl_value("vm.dirty_ratio") == "10"
            and sysctl_value("vm.dirty_background_ratio") == "5"
            and sysctl_value("vm.vfs_cache_pressure") == "50"
        )
        sw_io.set_active(io_live)
        sysctl_grid.attach(Gtk.Label(label="<b>I/O Stutter-preventie (SSD/NVMe):</b>\n<span size='small'>Geoptimaliseerde dirty_ratio (10/5) voorkomt desktop-bevriezingen bij zwaar schrijven</span>", use_markup=True, xalign=0.0), 0, 1, 1, 1)
        sysctl_grid.attach(sw_io, 1, 1, 1, 1)

        # Tweak 3: Inotify verhoging
        sw_ino = aurora_switch()
        try:
            inotify_live = int(sysctl_value("fs.inotify.max_user_watches") or "0") >= 524288 and int(sysctl_value("fs.inotify.max_user_instances") or "0") >= 1024
        except ValueError:
            inotify_live = False
        sw_ino.set_active(inotify_live)
        sysctl_grid.attach(Gtk.Label(label="<b>Inotify-limiet verhogen voor IDE's:</b>\n<span size='small'>Verhoogt max_user_watches naar 524288 voor VS Code, JetBrains en Electron apps</span>", use_markup=True, xalign=0.0), 0, 2, 1, 1)
        sysctl_grid.attach(sw_ino, 1, 2, 1, 1)

        def on_game_toggled(s, st):
            set_setting("tuning.low-latency", bool(st))
            if st:
                run_admin_cmd("sysctl-apply", "net.ipv4.tcp_congestion_control", "bbr")
                run_admin_cmd("sysctl-apply", "net.core.default_qdisc", "fq")
                run_admin_cmd("sysctl-apply", "vm.swappiness", "10")
                run_admin_cmd("sysctl-apply", "kernel.sched_autogroup_enabled", "1")
            else:
                run_admin_cmd("sysctl-apply", "vm.swappiness", "60")

        def on_io_toggled(s, st):
            set_setting("tuning.io", bool(st))
