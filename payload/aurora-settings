        night_grid.attach(night_slider, 1, 1, 1, 1)

        def toggle_night(s, state):
            set_setting("display.nightlight", bool(state))
            if state:
                temp = int(night_adj.get_value())
                set_setting("display.nightlight-temperature", temp)
                run_cmd("pkill", "wlsunset")
