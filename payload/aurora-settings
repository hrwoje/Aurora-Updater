            drv_spinner.start()
            btn_scan_drv.set_sensitive(False)
            while child := drv_list.get_first_child():
                drv_list.remove(child)

            def worker():
                lspci_out = (run_cmd("lspci", "-nnk").stdout or "")
                recommended = []
                installed = set(installed_packages())
                live_drivers = driver_inventory()

                # AMD GPU
                if "1002:" in lspci_out or "Radeon" in lspci_out:
                    if "mesa-vulkan-radeon" not in installed: recommended.append(("mesa-vulkan-radeon", "AMD Radeon Vulkan 3D Driver (RADV)", "Grafische kaart (AMD)"))
                    if "mesa-vaapi" not in installed: recommended.append(("mesa-vaapi", "AMD Radeon Hardware Videoversnelling (VA-API)", "Grafische kaart (AMD)"))

                # MediaTek Wi-Fi (MT7925 / MT7927)
                if ("14c3:" in lspci_out or "MT792" in lspci_out) and not any(x["driver"] == "mt7925e" for x in live_drivers):
                    recommended.append(("mt76-mt7925-dkms", "MediaTek Wi-Fi 7 MT7925/MT7927 Kernel Driver & Firmware", "Draadloos Netwerk (Wi-Fi 7)"))

                # Intel GPU
                if "8086:" in lspci_out and "VGA" in lspci_out:
                    if "intel-media-driver" not in installed: recommended.append(("intel-media-driver", "Intel Broadwell/TigerLake/Iris VA-API Driver", "Grafische kaart (Intel)"))
                    if "mesa-vulkan-intel" not in installed: recommended.append(("mesa-vulkan-intel", "Intel Vulkan 3D Driver (ANV)", "Grafische kaart (Intel)"))

                # NVIDIA GPU
                if "10de:" in lspci_out:
                    if "nvidia-dkms" not in installed: recommended.append(("nvidia-dkms", "NVIDIA Proprietary Graphics Driver & CUDA", "Grafische kaart (NVIDIA)"))

                def ui_done():
                    drv_spinner.stop()
                    btn_scan_drv.set_sensitive(True)
                    for drv in live_drivers:
                        drv_list.append(Gtk.Label(label=f"<b>{esc(drv['device'])}</b>\n<span size='small'>Actief: {esc(drv['driver'])} | beschikbaar: {esc(drv['modules'] or 'onbekend')}</span>", use_markup=True, xalign=0.0))
                    if not recommended:
                        drv_list.append(Gtk.Label(label="Geen ontbrekend pakketadvies; actieve drivers hierboven zijn de gemeten toestand.", xalign=0.0))
                        return
                    for drv_pkg, drv_desc, drv_hw in recommended:
                        r = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                        chk = run_cmd("xbps-query", "-s", drv_pkg)
                        is_inst = chk and chk.returncode == 0

                        inf = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                        inf.set_hexpand(True)
                        inf.append(Gtk.Label(label=f"<b>{esc(drv_pkg)}</b> — {esc(drv_hw)}", use_markup=True, xalign=0.0))
                        inf.append(Gtk.Label(label=f"<span size='small' alpha='75%'>{esc(drv_desc)}</span>", use_markup=True, xalign=0.0))
                        r.append(inf)

                        if is_inst:
                            badge = Gtk.Label(label="Geïnstalleerd")
                            badge.add_css_class("success")
                            r.append(badge)
                        else:
                            btn_inst_d = Gtk.Button(label="Installeer Driver")
                            btn_inst_d.add_css_class("suggested-action")
                            btn_inst_d.connect("clicked", lambda b, dp=drv_pkg: (
                                run_admin_cmd("driver-install", dp),
                                scan_drivers(None)
                            ))
                            r.append(btn_inst_d)

                        drv_list.append(r)
                        drv_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

                GLib.idle_add(ui_done)

            threading.Thread(target=worker, daemon=True).start()

        btn_scan_drv.connect("clicked", scan_drivers)
        btn_fwupd.connect("clicked", lambda b: run_admin_cmd("fwupd-update"))
        scan_drivers(None)

        # ── Aanvullende grafische software, microcode & diagnostiek ─────────
        # Alleen vaste, gecontroleerde pakketnamen worden aangeboden. Een pakket
        # krijgt pas een installatieknop als het in de actieve XBPS-bronnen staat.
        extra_card = self.create_card_group(
            "Aanvullende grafische software & hardwareondersteuning",
            "OpenGL/Mesa, Vulkan, videoversnelling, firmware en CPU-microcode uit de officiële Void XBPS-bronnen",
        )
        extra_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        extra_box.append(Gtk.Label(
            label="Deze pakketten leveren gebruikersruimte-ondersteuning en diagnostiek. Kernelpatches worden niet blind toegepast; kernelupdates blijven via het officiële Void-kernelpakket lopen.",
            xalign=0.0, wrap=True,
        ))
        extra_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        extra_box.append(extra_list)

        try:
            cpu_vendor = open("/proc/cpuinfo", encoding="utf-8", errors="ignore").read(8192)
        except Exception:
            cpu_vendor = ""
        extra_packages = [
            ("mesa", "Mesa OpenGL runtime", "OpenGL-basis voor AMD/Intel en software die OpenGL gebruikt"),
            ("mesa-dri", "Mesa DRI-renderers", "Hardwareversnelde OpenGL-renderers"),
            ("mesa-vulkan-radeon", "RADV Vulkan", "Vulkan voor AMD Radeon"),
            ("mesa-vaapi", "Mesa VA-API", "Hardware videodecodering/-encoding"),
            ("vulkan-loader", "Vulkan loader", "Vulkan-runtime voor applicaties"),
            ("vulkan-tools", "Vulkan diagnose-tools", "vulkaninfo en eenvoudige Vulkan-controle"),
            ("mesa-demos", "OpenGL diagnose-tools", "glxinfo/glxgears voor controle van OpenGL"),
            ("libva-utils", "VA-API diagnose-tools", "vainfo voor videoversnelling"),
            ("linux-firmware", "Linux firmware", "Firmware voor netwerk, GPU en andere hardware"),
            ("fwupd", "fwupd firmwarebeheer", "Veilige firmwarecontrole via LVFS wanneer ondersteund"),
        ]
        if "AuthenticAMD" in cpu_vendor:
            extra_packages.append(("amd-ucode", "AMD CPU-microcode", "Microcode-updates voor AMD-processors"))
        elif "GenuineIntel" in cpu_vendor:
            extra_packages.append(("intel-ucode", "Intel CPU-microcode", "Microcode-updates voor Intel-processors"))

        def pkg_in_repo(pkg):
            q = run_cmd("xbps-query", "-Rs", f"^{pkg}-", timeout=15)
            return bool(q and q.returncode == 0 and q.stdout.strip())

        for pkg, title, desc in extra_packages:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            info.set_hexpand(True)
            info.append(Gtk.Label(label=f"<b>{esc(title)}</b> <span size='small'>({esc(pkg)})</span>", use_markup=True, xalign=0.0))
            info.append(Gtk.Label(label=esc(desc), xalign=0.0, wrap=True))
            row.append(info)
            installed = bool(run_cmd("xbps-query", "-s", pkg) and run_cmd("xbps-query", "-s", pkg).returncode == 0)
            if installed:
                badge = Gtk.Label(label="Geïnstalleerd")
                badge.add_css_class("success")
                row.append(badge)
            elif pkg_in_repo(pkg):
                btn_pkg = Gtk.Button(label="Installeren")
                btn_pkg.add_css_class("suggested-action")
                btn_pkg.connect("clicked", lambda b, p=pkg: (run_admin_cmd("pkg-install", p), b.set_label("Opdracht verstuurd"), b.set_sensitive(False)))
                row.append(btn_pkg)
            else:
                row.append(Gtk.Label(label="Niet in actieve repository"))
            extra_list.append(row)
            extra_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        extra_card.get_last_child().append(extra_box)
        box.append(extra_card)

        # ── Aangesloten Apparatuur Card ───────────────────────────────────────
        dev_card = self.create_card_group("Aangesloten Apparatuur (USB, PCIe, Opslag)", "Gedetailleerd overzicht van fysieke hardwarecomponenten")
        dev_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        usb_res = run_cmd("lsusb")
        if usb_res and usb_res.stdout:
            dev_vbox.append(Gtk.Label(label="<b>USB-apparaten:</b>", use_markup=True, xalign=0.0))
            u_lbl = Gtk.Label(label=esc(usb_res.stdout), xalign=0.0)
            u_lbl.add_css_class("monospace")
            u_lbl.set_selectable(True)
            dev_vbox.append(u_lbl)

        blk_res = run_cmd("lsblk", "-o", "NAME,SIZE,TYPE,MOUNTPOINT")
        if blk_res and blk_res.stdout:
            dev_vbox.append(Gtk.Label(label="<b>Opslagpartities (Schijven):</b>", use_markup=True, xalign=0.0))
            blk_lbl = Gtk.Label(label=esc(blk_res.stdout), xalign=0.0)
            blk_lbl.add_css_class("monospace")
            blk_lbl.set_selectable(True)
            dev_vbox.append(blk_lbl)

        dev_card.get_last_child().append(dev_vbox)
        box.append(dev_card)

        scrolled.set_child(box)
        return scrolled

    # ── 17. Gebruikers & Accounts Pagina ─────────────────────────────────────
    def build_users_page(self):
        scrolled = Gtk.ScrolledWindow()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(20); box.set_margin_bottom(20); box.set_margin_start(24); box.set_margin_end(24)
        box.append(self.create_page_header("Gebruikers & Accounts", "Beheer gebruikersaccounts, wachtwoorden, beheerdersrechten en avatars", "system-users-symbolic"))

        users_card = self.create_card_group("Lokale Gebruikers", "AccountsService gebruikersoverzicht op deze computer")
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_add = Gtk.Button(label="➕ Gebruiker toevoegen")
        btn_add.add_css_class("suggested-action")
        top_bar.append(btn_add)
        users_card.get_last_child().append(top_bar)

        u_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        u_list.set_margin_top(12)
        users_card.get_last_child().append(u_list)
        box.append(users_card)

        def refresh_users():
            while child := u_list.get_first_child():
                u_list.remove(child)

            users = [u for u in pwd.getpwall() if 1000 <= u.pw_uid < 60000 and u.pw_shell not in ("/sbin/nologin", "/bin/false")]

            for u in users:
                urow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                urow.append(self.get_user_avatar_image(u.pw_name, size=48))

                info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                disp_name = u.pw_gecos or u.pw_name
                info_box.append(Gtk.Label(label=f"<b>{esc(disp_name)}</b> ({esc(u.pw_name)})", use_markup=True, xalign=0.0))

                is_admin = False
                try:
                    is_admin = u.pw_name in grp.getgrnam("wheel").gr_mem
                except Exception:
                    pass

                info_box.append(Gtk.Label(label=f"<span size='small' alpha='75%'>Type: {'Beheerder (Sudo/Wheel)' if is_admin else 'Standaardgebruiker'} | UID: {u.pw_uid}</span>", use_markup=True, xalign=0.0))
                urow.append(info_box)

                btn_pw = Gtk.Button(label="Wachtwoord")
                btn_pw.connect("clicked", lambda b, un=u.pw_name: self.prompt_change_password(un))
                urow.append(btn_pw)

                btn_av = Gtk.Button(label="Profielfoto")
                btn_av.connect("clicked", lambda b, un=u.pw_name: self.prompt_change_avatar(un, refresh_users))
                urow.append(btn_av)

                if u.pw_uid != 1000:
                    btn_del = Gtk.Button(label="Verwijderen")
                    btn_del.add_css_class("destructive-action")
                    btn_del.connect("clicked", lambda b, un=u.pw_name: (
                        subprocess.run(["pkexec", "/usr/bin/aurora-user-admin", "delete-user", un]),
                        refresh_users()
                    ))
                    urow.append(btn_del)

                u_list.append(urow)
                u_list.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))

        btn_add.connect("clicked", lambda b: self.prompt_add_user(refresh_users))
        refresh_users()

        scrolled.set_child(box)
        return scrolled

    def prompt_add_user(self, callback):
        dialog = Gtk.Window(transient_for=self.win, modal=True, title="Nieuwe gebruiker toevoegen")
        dialog.set_default_size(380, 260)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(16); box.set_margin_bottom(16); box.set_margin_start(16); box.set_margin_end(16)

        box.append(Gtk.Label(label="Gebruikersnaam (kleine letters, geen spaties):", xalign=0.0))
        u_entry = Gtk.Entry()
        box.append(u_entry)

        box.append(Gtk.Label(label="Volledige weergavenaam:", xalign=0.0))
        g_entry = Gtk.Entry()
        box.append(g_entry)

        box.append(Gtk.Label(label="Wachtwoord:", xalign=0.0))
        pw_entry = Gtk.PasswordEntry()
        box.append(pw_entry)

        chk_admin = Gtk.CheckButton(label="Beheerdersrechten toekennen (lid van wheel)")
        box.append(chk_admin)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.END)
        cancel_btn = Gtk.Button(label="Annuleren")
        create_btn = Gtk.Button(label="Aanmaken")
        create_btn.add_css_class("suggested-action")
        cancel_btn.connect("clicked", lambda b: dialog.destroy())

        def on_create(b):
            un = u_entry.get_text().strip().lower()
            gec = g_entry.get_text().strip() or un
            pw = pw_entry.get_text()
            adm = "yes" if chk_admin.get_active() else "no"
            if un and pw:
                subprocess.run(["pkexec", "/usr/bin/aurora-user-admin", "add-user", un, gec, pw, adm])
                dialog.destroy()
                callback()

        create_btn.connect("clicked", on_create)
        btn_box.append(cancel_btn); btn_box.append(create_btn); box.append(btn_box)
        dialog.set_child(box)
        dialog.present()

    def prompt_change_password(self, username):
        dialog = Gtk.Window(transient_for=self.win, modal=True, title=f"Wachtwoord voor {username}")
        dialog.set_default_size(360, 180)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_margin_top(16); box.set_margin_bottom(16); box.set_margin_start(16); box.set_margin_end(16)

        box.append(Gtk.Label(label=f"Nieuw wachtwoord voor <b>{esc(username)}</b>:", use_markup=True, xalign=0.0))
        pw_entry = Gtk.PasswordEntry()
        box.append(pw_entry)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_box.set_halign(Gtk.Align.END)
        cancel_btn = Gtk.Button(label="Annuleren")
        save_btn = Gtk.Button(label="Opslaan")
        save_btn.add_css_class("suggested-action")
        cancel_btn.connect("clicked", lambda b: dialog.destroy())

        def on_save(b):
            pw = pw_entry.get_text()
            if pw:
                subprocess.run(["pkexec", "/usr/bin/aurora-user-admin", "set-password", username, pw])
                dialog.destroy()

        save_btn.connect("clicked", on_save)
        btn_box.append(cancel_btn); btn_box.append(save_btn); box.append(btn_box)
        dialog.set_child(box)
        dialog.present()

    def prompt_change_avatar(self, username, callback):
        dlg = Gtk.FileChooserNative.new(f"Kies profielfoto voor {username}", self.win, Gtk.FileChooserAction.OPEN, "Selecteren", "Annuleren")
        img_filter = Gtk.FileFilter()
        img_filter.set_name("Afbeeldingen (*.png, *.jpg)")
        img_filter.add_pattern("*.png")
        img_filter.add_pattern("*.jpg")
        dlg.add_filter(img_filter)

        def on_resp(d, resp):
            if resp == Gtk.ResponseType.ACCEPT:
                f = d.get_file()
                if f:
                    subprocess.run(["pkexec", "/usr/bin/aurora-user-admin", "set-avatar", username, f.get_path()])
                    callback()
            d.destroy()

        dlg.connect("response", on_resp)
        dlg.show()


def main():
    target_page = None
    args = sys.argv[1:]
    for i, a in enumerate(args):
        if a in ("--page", "-p") and i + 1 < len(args):
            target_page = args[i + 1]
            break
        elif a.startswith("--page="):
            target_page = a.split("=", 1)[1]
            break

    app = AuroraSettingsApp(initial_page=target_page)
    sys.exit(app.run([sys.argv[0]]))


if __name__ == "__main__":
    main()
