def run_cmd(*args, timeout=15):
    try:
        res = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return res
    except Exception:
        return None


def sysctl_value(key):
    """Return the live kernel value; never invent a value for the UI."""
    res = run_cmd("sysctl", "-n", key, timeout=5)
    if not res or res.returncode != 0:
        return ""
    return (res.stdout or "").strip()


def network_traffic_bytes():
    """Read real aggregate RX/TX counters from kernel network interfaces."""
    rx = tx = 0
    for path in glob.glob("/sys/class/net/*/statistics/rx_bytes"):
        try:
            rx += int(open(path, encoding="ascii").read().strip())
            tx_path = path.replace("/statistics/rx_bytes", "/statistics/tx_bytes")
            tx += int(open(tx_path, encoding="ascii").read().strip())
        except (OSError, ValueError):
            continue
    return rx, tx


def active_network_connections():
    """Return live sockets from ss, with direction inferred from listeners."""
    listeners = set()
    listen_res = run_cmd("ss", "-H", "-ltn", timeout=5)
    if listen_res and listen_res.returncode == 0:
        for line in listen_res.stdout.splitlines():
            cols = line.split()
            if len(cols) >= 4:
                endpoint = cols[3].rsplit(":", 1)[-1]
                if endpoint.isdigit(): listeners.add(int(endpoint))
    res = run_cmd("ss", "-H", "-tunap", timeout=8)
    if not res or res.returncode != 0:
        return []
    rows = []
    for line in res.stdout.splitlines():
        cols = line.split()
        if len(cols) < 5 or cols[0] not in ("tcp", "tcp6", "udp", "udp6"):
            continue
        local, peer = cols[4], cols[5] if len(cols) > 5 else "-"
        def endpoint(value):
            if value.startswith("[") and "]" in value:
                host, _, port = value[1:].partition("]:")
            else:
                host, _, port = value.rpartition(":")
            try:
                ipaddress.ip_address(host)
            except ValueError:
                return None, port
            return host, port
        lip, lport = endpoint(local); pip, pport = endpoint(peer)
        if not pip or pip in ("0.0.0.0", "::", "*"):
            continue
        direction = "inkomend" if lport.isdigit() and int(lport) in listeners else "uitgaand"
        rows.append({"proto": cols[0], "state": cols[1], "local": local, "peer": peer, "ip": pip, "port": pport, "direction": direction})
    return rows[:100]


# User-owned persistent state for Aurora Settings.  The original application
# recreated several controls with hard-coded defaults on every start.  Keep
# the UI state separately from Noctalia and system-managed configuration.
SETTINGS_PATH = os.path.expanduser("~/.config/aurora/settings.json")


def load_settings():
    try:
        with open(SETTINGS_PATH, "r", encoding="utf-8") as fh:
            data = json.load(fh)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def save_settings(data):
    os.makedirs(os.path.dirname(SETTINGS_PATH), mode=0o700, exist_ok=True)
    tmp = SETTINGS_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, SETTINGS_PATH)


def setting(key, default):
    return load_settings().get(key, default)


def set_setting(key, value):
    data = load_settings()
    data[key] = value
    save_settings(data)


def installed_packages(prefixes=()):
    result = []
    res = run_cmd("xbps-query", "-l", timeout=20)
    if not res or res.returncode != 0:
        return result
    for line in res.stdout.splitlines():
        m = re.match(r"^ii\s+(\S+)", line.strip())
        if m and (not prefixes or m.group(1).startswith(prefixes)):
            result.append(m.group(1))
    return result


def kernel_inventory():
    entries = []
    for image in sorted(glob.glob("/boot/vmlinuz-*")):
        version = os.path.basename(image)[len("vmlinuz-"):]
        entries.append({
            "version": version,
            "image": image,
            "modules": os.path.isdir(f"/lib/modules/{version}"),
            "initramfs": os.path.exists(f"/boot/initramfs-{version}.img"),
            "active": version == platform.release(),
        })
    packages = installed_packages(("linux",))
    for entry in entries:
        entry["package"] = next((p for p in packages if entry["version"] in p), "")
    return entries


def driver_inventory():
    result = []
    res = run_cmd("lspci", "-nnk", timeout=20)
    if not res or res.returncode != 0:
        return result
    current = None
    for line in res.stdout.splitlines():
        if line and not line.startswith(("\t", " ")):
            if current: result.append(current)
            current = {"device": line.strip(), "driver": "niet geladen", "modules": ""}
        elif current and "Kernel driver in use:" in line:
            current["driver"] = line.split(":", 1)[1].strip()
        elif current and "Kernel modules:" in line:
            current["modules"] = line.split(":", 1)[1].strip()
    if current: result.append(current)
    return [x for x in result if any(k in x["device"] for k in ("VGA", "3D", "Network controller", "Ethernet controller", "Audio device", "Non-Volatile memory"))]


def run_admin_cmd(*args, timeout=120):
    try:
        full_cmd = ["pkexec", "/usr/bin/aurora-system-admin"] + list(args)
        res = subprocess.run(
            full_cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return res
    except Exception as e:
        return None


def run_network_admin(*args, timeout=120):
    if not args or args[0] != "ufw":
        return None
    # Execute only the system UFW binary through polkit; never execute a
    # user-writable helper as root.
    if len(args) >= 4 and args[1] in ("allow", "deny") and args[2] == "from":
        try:
            return subprocess.run(["pkexec", "/usr/sbin/ufw", args[1], "from", args[3]], capture_output=True, text=True, timeout=timeout)
        except Exception:
            return None
    return None


def run_security_cmd(binary, profile, timeout=120):
    allowed = {"aa-enforce": "/usr/sbin/aa-enforce", "aa-complain": "/usr/sbin/aa-complain", "aa-disable": "/usr/sbin/aa-disable"}
    if binary not in allowed or not profile or "/" in profile or not re.fullmatch(r"[A-Za-z0-9_.-]+", profile):
        return None
    try:
        return subprocess.run(["pkexec", allowed[binary], profile], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def run_ufw(*args, timeout=120):
    allowed = {"enable", "disable", "default", "allow", "deny", "delete", "status", "app"}
    if not args or args[0] not in allowed:
        return None
    try:
        return subprocess.run(["pkexec", "/usr/sbin/ufw", *args], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def esc(s):
    return GLib.markup_escape_text(str(s) if s is not None else "")


def get_current_folder_state():
    conf_path = os.path.expanduser("~/.config/aurora/papirus.toml")
    mode = "fixed"
    color = "blue"
    if os.path.exists(conf_path):
        try:
            with open(conf_path, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("mode"):
                        mode = line.split("=")[1].strip().strip('"\'')
                    elif line.startswith("color_light") or line.startswith("color"):
                        color = line.split("=")[1].strip().strip('"\'')
        except Exception:
            pass
    return {"mode": mode, "color": color}


def check_xbps_updates():
    try:
        res = subprocess.run(["xbps-install", "-un"], capture_output=True, text=True, timeout=15)
        if res.returncode != 0:
            return []
        updates = []
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            if " " in line:
                parts = line.split()
                if len(parts) >= 2:
                    updates.append(f"{parts[0]} -> {parts[1]}")
                else:
                    updates.append(line)
            elif "->" in line:
                updates.append(line)
        return updates
    except Exception:
        return []


def aurora_logo_image(size):
    """Use the same Aurora logo that Limine/Noctalia branding references."""
    logo_path = "/usr/share/aurora/logo.png"
    if os.path.exists(logo_path):
        try:
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(logo_path, size, size, True)
            return Gtk.Image.new_from_pixbuf(pix)
        except Exception:
            pass
    image = Gtk.Image.new_from_icon_name("aurora")
    image.set_pixel_size(size)
    return image

def install_aurora_widget_style():
    """Give every Aurora page the same compact GTK4 control geometry."""
    display = Gdk.Display.get_default()
