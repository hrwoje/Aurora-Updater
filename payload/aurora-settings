        dns6.set_text(str(setting("dns.ipv6", "2620:fe::fe,2606:4700:4700::1111")))
        dns_grid.attach(Gtk.Label(label="IPv4 DNS-servers", xalign=0.0), 0, 0, 1, 1)
        dns_grid.attach(dns4, 1, 0, 1, 1)
        dns_grid.attach(Gtk.Label(label="IPv6 DNS-servers", xalign=0.0), 0, 1, 1, 1)
        dns_grid.attach(dns6, 1, 1, 1, 1)
        dns_apply = Gtk.Button(label="DNS opslaan en toepassen")
        dns_apply.add_css_class("suggested-action")
        dns_grid.attach(dns_apply, 1, 2, 1, 1)
        dns_status = Gtk.Label(label="", xalign=0.0)
        dns_grid.attach(dns_status, 1, 3, 1, 1)

        def apply_dns(b):
            v4 = ",".join(x.strip() for x in dns4.get_text().split(",") if x.strip())
            v6 = ",".join(x.strip() for x in dns6.get_text().split(",") if x.strip())
            set_setting("dns.ipv4", v4); set_setting("dns.ipv6", v6)
            active = run_cmd("nmcli", "-t", "-f", "GENERAL.CONNECTION", "device", "show")
            con = ""
            if active and active.stdout:
                for line in active.stdout.splitlines():
                    if line.startswith("GENERAL.CONNECTION:"):
                        con = line.split(":", 1)[1].strip()
                        if con and con != "--": break
            if not con:
                dns_status.set_text("DNS opgeslagen; actieve NetworkManager-verbinding niet gevonden.")
                return
            res = run_cmd("nmcli", "connection", "modify", con, "ipv4.ignore-auto-dns", "yes", "ipv4.dns", v4, "ipv6.ignore-auto-dns", "yes", "ipv6.dns", v6)
            if res and res.returncode == 0:
                run_cmd("nmcli", "connection", "up", con)
                dns_status.set_text(f"DNS toegepast op {con} (IPv4 + IPv6).")
            else:
                dns_status.set_text("DNS opgeslagen, maar NetworkManager kon de verbinding niet wijzigen.")
        dns_apply.connect("clicked", apply_dns)
        dns_card.get_last_child().append(dns_grid)
        box.append(dns_card)

        scrolled.set_child(box)
        return scrolled

