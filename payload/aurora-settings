        btn_reload_aa = Gtk.Button(label="Profielen Herladen")
        btn_reload_aa.connect("clicked", lambda b: run_admin_cmd("apparmor-reload"))
        aa_box.append(btn_reload_aa)
        aa_profiles = [os.path.basename(p) for p in glob.glob("/etc/apparmor.d/*") if os.path.isfile(p)]
        aa_profiles = sorted(p for p in aa_profiles if not p.startswith("."))
        if aa_profiles:
            aa_grid = Gtk.Grid(column_spacing=8, row_spacing=8)
            aa_drop = Gtk.DropDown.new_from_strings(aa_profiles)
            aa_mode = Gtk.DropDown.new_from_strings(["Enforce (blokkeren)", "Complain (alleen melden)", "Uitschakelen"])
            aa_apply = Gtk.Button(label="Profiel toepassen")
            aa_status = Gtk.Label(label="", xalign=0.0)
            aa_grid.attach(aa_drop, 0, 0, 1, 1); aa_grid.attach(aa_mode, 1, 0, 1, 1); aa_grid.attach(aa_apply, 2, 0, 1, 1); aa_grid.attach(aa_status, 0, 1, 3, 1)
            def apply_aa_profile(button):
                name = aa_profiles[aa_drop.get_selected()]
                binary = ("aa-enforce", "aa-complain", "aa-disable")[aa_mode.get_selected()]
                result = run_security_cmd(binary, name)
                if result and result.returncode == 0:
                    set_setting("apparmor.profile." + name, binary)
                    aa_status.set_text(f"{name}: {binary} toegepast")
                else:
                    aa_status.set_text((result.stderr if result else "Polkit/AppArmoractie mislukt").strip())
            aa_apply.connect("clicked", apply_aa_profile)
            aa_box.append(aa_grid)
