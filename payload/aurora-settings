        ai_script = os.path.expanduser("~/.local/bin/aurora-ai-manager")
        ai_report_path = os.path.expanduser("~/.local/state/aurora-ai-manager/last-report.json")
        ai_memory_path = os.path.expanduser("~/.local/state/aurora-ai-manager/knowledge.json")
        def ai_mode_changed(drop, pspec):
